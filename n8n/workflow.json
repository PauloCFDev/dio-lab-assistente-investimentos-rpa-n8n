    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst clientes = {};\n\nfor (const item of items) {\n  const d = item.json;\n  const chave = d.email;\n\n  if (!clientes[chave]) {\n    clientes[chave] = {\n      nome: d.nome,\n      email: d.email,\n      saldo: d.saldo,\n      perfil: d.perfil,\n      recomendacoes: []\n    };\n  }\n\n  clientes[chave].recomendacoes.push({\n    produto: d.produto,\n    minimo: d.minimo,\n    rentabilidade: d.rentabilidade,\n    mensagem: d.mensagem\n  });\n}\n\nreturn Object.values(clientes).map(cliente => ({\n  json: cliente\n}));\n"
      },
